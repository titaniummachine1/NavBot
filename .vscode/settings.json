{
  "editor.formatOnSave": true,
  "[lua]": {
    "editor.defaultFormatter": "JohnnyMorganz.stylua",
    "editor.formatOnSave": true
  },
  "stylua.searchParentDirectories": true,
  "stylua.targetReleaseVersion": "latest",
  "Lua.runtime.version": "Lua 5.4",
  "Lua.workspace.library": [
    "C:/gitProjects/Lmaobox-Annotations/library",
    "${workspaceFolder}/types"
  ],
  "Lua.workspace.checkThirdParty": false,
  "Lua.workspace.ignoreDir": ["**/.git", "vendor", "vendor/**", "NavBot.lua"],
  "Lua.diagnostics.globals": [
    "G",
    "client",
    "entities",
    "globals",
    "callbacks",
    "engine",
    "gui",
    "input",
    "draw",
    "filesystem",
    "steam",
    "vector",
    "EulerAngles",
    "Vector3",
    "IN_ATTACK",
    "IN_JUMP",
    "IN_DUCK",
    "IN_FORWARD",
    "IN_BACK",
    "IN_MOVERIGHT",
    "IN_MOVELEFT",
    "FL_ONGROUND",
    "FL_DUCKING",
    "MASK_PLAYERSOLID",
    "MASK_PLAYERSOLID_BRUSHONLY",
    "KEY_LSHIFT",
    "TF_CLASS_MEDIC",
    "TF_CLASS_SCOUT",
    "TF_CLASS_SOLDIER",
    "TF_CLASS_PYRO",
    "TF_CLASS_DEMOMAN",
    "TF_CLASS_HEAVY",
    "TF_CLASS_ENGINEER",
    "TF_CLASS_SNIPER",
    "TF_CLASS_SPY",
    "printc",
    "GetScriptName",
    "Notify",
    "WPlayer",
    "Common",
    "Navigation",
    "TimMenu"
  ],
  "Lua.diagnostics.disable": [
    "duplicate-set-field",
    "undefined-field",
    "lowercase-global",
    "duplicate-doc-field"
  ],
  "Lua.completion.enable": true,
  "Lua.completion.callSnippet": "Both",
  "Lua.hint.enable": true,
  "Lua.hint.paramName": "All",
  "Lua.hint.setType": true,
  "files.associations": {
    "*.lua": "lua",
    "**/vendor/**/*.lua": "plaintext"
  },
  "files.exclude": {
    "**/vendor/luabundle/**": true
  },
  "files.watcherExclude": {
    "**/vendor/**": true
  },
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "files.autoSave": "onFocusChange",
  "achilleshr.runonsave": {
    "autoSave": true,
    "onSave": true,
    "commands": [
      {
        "match": "NavBot[/\\\\].*\\.lua$",
        "isAsync": false,
        "cmd": "npm run build",
        "autoShowOutputPanel": "always"
      },
      {
        "match": "bundle\\.js$",
        "isAsync": false,
        "cmd": "npm run build",
        "autoShowOutputPanel": "always"
      }
    ]
  },
  "emeraldwalk.runonsave": {
    "autoSave": true,
    "commands": [
      {
        "match": "NavBot[/\\\\].*\\.lua$",
        "isAsync": false,
        "cmd": "npm run build",
        "autoShowOutputPanel": "always"
      },
      {
        "match": "bundle\\.js$",
        "isAsync": false,
        "cmd": "npm run build",
        "autoShowOutputPanel": "always"
      }
    ]
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell"
}
