{
  "name": "navbot",
  "version": "2.0.8",
  "description": "Navigation and pathfinding bot for LMAOBox",
  "type": "module",
  "scripts": {
    "bundle": "node bundle.js",
    "deploy": "node scripts/deploy.cjs",
    "watch": "node scripts/simple-watch.cjs",
    "dev": "node scripts/simple-watch.cjs",
    "version:get": "node scripts/version-manager.cjs get",
    "version:set": "node scripts/version-manager.cjs set",
    "version:bump": "node scripts/version-manager.cjs bump",
    "version:auto": "node scripts/version-manager.cjs auto",
    "build": "npm run bundle && npm run deploy"
  },
  "dependencies": {
    "lua-format": "^1.3.4",
    "luabundle": "^1.7.0",
    "chokidar": "^3.5.3",
    "concurrently": "^7.6.0"
  },
  "devDependencies": {
    "commitizen": "^4.3.0",
    "cz-conventional-changelog": "^3.3.0"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "keywords": [
    "lmaobox",
    "bot",
    "navigation",
    "pathfinding",
    "tf2"
  ],
  "author": "titaniummachine1",
  "license": "MIT"
}
